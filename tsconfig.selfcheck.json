{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".selfcheck",
    "rootDir": ".",
    "types": [],
    "lib": ["ES2020"]
  },
  "include": [
    "scripts/selfcheck.ts",
    "src/types.ts",
    "src/game/**/*.ts",
    "src/data/**/*.ts",
    "src/art/cues/**/*.ts",
    "src/lib/phonemes.ts",
    "src/lib/speechProfile.ts"
  ]
}
