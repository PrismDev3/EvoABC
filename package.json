{
  "name": "evoabc",
  "version": "1.2.4",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "selfcheck": "tsc -p tsconfig.selfcheck.json && node .selfcheck/scripts/selfcheck.js",
    "assets": "node scripts/generate-assets.js && node scripts/generate-audio.js",
    "audio:check": "node scripts/check-audio.js",
    "icons:list": "node scripts/list-icons.js",
    "audit": "node scripts/audit.js",
    "bundle": "expo export --platform ios --output-dir dist",
    "prebuild:ios": "expo prebuild --platform ios"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14"
  }
}
